{
  "name": "nexus-ai-orchestrator",
  "version": "0.7.2",
  "description": "NEXUS — Windows 本机 AI 编排中枢（桌面初版）",
  "homepage": "https://jacob-gif-lang.github.io/AI-Command-Center/",
  "main": "electron/main.js",
  "bin": {
    "nexus": "bin/nexus.js"
  },
  "files": [
    "bin/",
    "server/",
    "renderer/",
    "electron/",
    "docs/",
    "README.md",
    "package.json",
    "!node_modules/**",
    "!.git.local-backup/**",
    "!.git/**",
    "!build/**",
    "!dist/**"
  ],
  "asar": true,
  "npmRebuild": false,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "node server/index.js",
    "check": "node server/selftest.js",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:win": "electron-builder --win nsis --x64 --config.npmRebuild=false --config.electronDist=node_modules/electron/dist",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --config.npmRebuild=false --config.electronDist=node_modules/electron/dist",
    "dist:mac": "electron-builder --mac zip --x64 --config.npmRebuild=false --config.electronDist=node_modules/electron/dist",
    "dist:all": "npm run dist:win && npm run dist:linux && npm run dist:mac"
  },
  "keywords": [
    "ai",
    "orchestrator",
    "windows",
    "ollama",
    "mcp",
    "desktop"
  ],
  "author": "Jacob",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
